{
  "name": "1608 — Aperçu privé",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "1608 — Aperçu boutique",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup python3 -m http.server 8000 --bind 127.0.0.1 > /tmp/1608-preview.log 2>&1 < /dev/null &"
}
